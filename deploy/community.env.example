# Copy to /opt/relay-community/env/community.env and chmod 600.
# See deploy/README.md for Chromium + cookie-jar setup.

# --- HITL ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWLIST_USER_ID=
FEEDBACK_ADAPTER=telegram

# --- VoltMem (sibling program on 127.0.0.1:8080) ---
VOLTMEM_URL=http://127.0.0.1:8080
VOLTMEM_API_KEY=
VOLTMEM_TENANT_ID=relay-community
# VOLTMEM_USER_ID is used only when VOLTMEM_TENANT_ID is unset

# --- Paths (ThinkPad layout) — each admin collection can diverge ---
REDDIT_DATA_DIR=/opt/relay-community/data
REDDIT_COOKIE_DIR=/opt/relay-community/data/cookies/reddit
ACTION_STORE_PATH=/opt/relay-community/data/action-store/actions.json
JOBS_DIR=/opt/relay-community/data/jobs
# ALLOWLIST_PATH=/opt/relay-community/data/allowlist/subreddits.json
COMMUNITY_RUNS_DIR=/opt/relay-community/logs/runs
# COMMUNITY_RUN_LOG=0
# Admin UI (relay-community-admin.service). Default bind is loopback only.
# ACTION_STORE_ADMIN_PORT=8787
# Tailscale / MagicDNS (e.g. http://hsv:8787) — same pattern as VoltMem :8080.
# Prefer Tailscale-only reachability; do not port-forward 8787 on the public LAN.
# ADMIN_HOST=0.0.0.0
# ACTION_STORE_ADMIN_HOST=0.0.0.0


# --- Draft LLM (@relay/llm) ---
# Default gemini (needs GEMINI_API_KEY). For Claude voice: anthropic + ANTHROPIC_API_KEY.
# COMMUNITY_DRAFT_LLM=gemini
# COMMUNITY_DRAFT_LLM=anthropic
# COMMUNITY_DRAFT_MODEL=claude-sonnet-4-5
GEMINI_API_KEY=
# ANTHROPIC_API_KEY=

# --- Scout / transport ---
SCOUT_SOURCE=auto
REDDIT_TRANSPORT=auto
REDDIT_DRY_RUN=true
# Notify-only: scout/draft/approve, human posts on Reddit (no automated comment).
COMMUNITY_POST_MODE=manual
# Read-only listing scout (no Reddit session). With key + SCOUT_SOURCE=auto, browser is skipped.
# REDDITAPIS_API_KEY=
# REDDITAPIS_BASE_URL=https://api.redditapis.com
# SCOUT_SOURCE=redditapis
REDDIT_BROWSER_HEADLESS=true
REDDIT_SCOUT_DELAY_MS=1500
REDDIT_SCOUT_SUB_BUDGET_MS=12000
COMMUNITY_MAX_JOBS=3
COMMUNITY_JOB_DELAY_MS=1500

# Empty scout after healthy allowlist skip → one forced discover (opt-in).
# Ship with off; after deploy verify /engage_discover, then flip to force on ThinkPad.
# COMMUNITY_DISCOVER_ON_EMPTY_SCOUT=off
# COMMUNITY_DISCOVER_ON_EMPTY_SCOUT=force
# COMMUNITY_DISCOVER_ON_EMPTY_SCOUT_MAX=1
# COMMUNITY_DISCOVER_ON_EMPTY_SCOUT_MAX_PER_DAY=3

# --- Browser dual-mode (see deploy/README.md) ---
# Timer / overnight: headless + HITL off (default when headless) — no hang on walls.
# Wall clear one-shot: keep HEADLESS=true, set INTERSTITIAL_HITL=true — scout/discover
# reopen a headed Chromium for CAPTCHA/login; solve via remote desktop, then Approve.
# Needs a graphical session on the ThinkPad (RustDesk / Tailscale+VNC). Telegram has no pixel stream.
# REDDIT_INTERSTITIAL_HITL=true
# Interactive jar prep:
# REDDIT_ENSURE_SESSION=true
# REDDIT_LOGIN_HEADED=true
# REDDIT_INTERSTITIAL_HITL=true

# --- Decide co-processor ---
# Overnight / timer: keep heuristic so scout does not hard-fail without Jev.
DECIDE_BACKEND=heuristic
# Live Jev (manual research runs only — set key + backend together):
# DECIDE_BACKEND=jev
# JEV_API_KEY=
# JEV_BASE_URL=https://api.typesafe.ai/v1/systemone
# Optional floors (0–1; defaults ~0.75):
# DECIDE_DISCOVER_MIN_CONFIDENCE=0.75
# DECIDE_INTERSTITIAL_MIN_CONFIDENCE=0.75
# DECIDE_LOGIN_MIN_CONFIDENCE=0.75
# DECIDE_COMPOSER_MIN_CONFIDENCE=0.75

# Optional env bootstrap (prefer HITL credential / cookie jar)
REDDIT_USERNAME=
REDDIT_PASSWORD=

# OAuth optional (API app) — not required for browser path
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=

GOSTYLENS_LP_BASE_URL=https://gostylens.app
REDDIT_USER_AGENT="Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/122.0.0.0 Safari/537.36"
