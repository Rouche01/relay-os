    "clean": "rm -rf dist dist-test"
  },
  "dependencies": {
    "@relay/protocol": "workspace:*",
    "playwright": "^1.43.0",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "6.0.3"
  }
}
