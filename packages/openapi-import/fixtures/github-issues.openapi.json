{
  "openapi": "3.0.3",
  "info": {
    "title": "GitHub REST (issues triage subset)",
    "description": "Trimmed GitHub REST excerpt for triage-gen (list issues + create comment).",
    "version": "0.1.0"
  },
  "servers": [
    {
      "url": "https://api.github.com"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "GitHub personal access token or installation token"
      }
    },
    "schemas": {
      "issue-comment": {
        "type": "object",
        "required": ["body"],
        "properties": {
          "body": {
            "type": "string",
            "description": "Markdown comment body"
          }
        }
      }
    }
  },
  "paths": {
    "/repos/{owner}/{repo}/issues": {
      "get": {
        "operationId": "issuesListForRepo",
        "tags": ["issues"],
        "summary": "List repository issues (filter by labels / state)",
        "parameters": [
          {
            "name": "owner",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          },
          {
            "name": "repo",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          },
          {
            "name": "labels",
            "in": "query",
            "schema": { "type": "string" },
            "description": "Comma-separated label names (e.g. bug)"
          },
          {
            "name": "state",
            "in": "query",
            "schema": { "type": "string" },
            "description": "open | closed | all"
          },
          {
            "name": "per_page",
            "in": "query",
            "schema": { "type": "integer" },
            "description": "1–100"
          },
          {
            "name": "page",
            "in": "query",
            "schema": { "type": "integer" }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/repos/{owner}/{repo}/issues/{issue_number}/comments": {
      "post": {
        "operationId": "issuesCreateComment",
        "tags": ["issues"],
        "summary": "Create a comment on an issue (irreversible)",
        "parameters": [
          {
            "name": "owner",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          },
          {
            "name": "repo",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          },
          {
            "name": "issue_number",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/issue-comment"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created"
          }
        }
      }
    }
  }
}
