{
  "name": "@relay/openapi-import",
  "version": "0.1.0",
  "private": true,
  "description": "OpenAPI 3 → Relay ServiceDescriptor YAML importer",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "relay-openapi-import": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json -w",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/test/*.test.js",
    "clean": "rm -rf dist dist-test",
    "gen:github-triage": "node dist/cli.js --input fixtures/github-issues.openapi.json --id github --operations issuesListForRepo,issuesCreateComment --out ../../apps/triage-gen/services/github.yaml --title \"GitHub REST (issues triage subset)\""
  },
  "dependencies": {
    "@relay/protocol": "workspace:*",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "6.0.3"
  }
}
