{
  "name": "@relay/phone-policy",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json -w",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/test/*.test.js",
    "dogfood:phone-browse": "tsc -p tsconfig.scripts.json && node dist-scripts/scripts/phone-browse-dogfood.js",
    "clean": "rm -rf dist dist-test dist-scripts"
  },
  "dependencies": {
    "@relay/computer-seat-policy": "workspace:*",
    "@relay/engines-computer": "workspace:*",
    "@relay/llm": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "6.0.3"
  }
}
