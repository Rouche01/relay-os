# Telegram (HITL)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWLIST_USER_ID=
FEEDBACK_ADAPTER=cli

# VoltMem sidecar
VOLTMEM_URL=http://127.0.0.1:8080
VOLTMEM_API_KEY=dev-secret
VOLTMEM_USER_ID=relay-local

# Reddit (read scout + optional write)
# Leave empty to use fixtures. SCOUT_SOURCE=auto uses reddit when configured.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=
REDDIT_USER_AGENT=relay-community-engager/0.1 by u/YOUR_USERNAME
# Keep true until you intentionally go live
REDDIT_DRY_RUN=true
SCOUT_SOURCE=auto

# Landing links (UTM applied to gostylens.app URLs on execute)
GOSTYLENS_LP_BASE_URL=https://gostylens.app
