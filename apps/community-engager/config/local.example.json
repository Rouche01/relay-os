{
  "_comment": "Copy to local.json (gitignored) for machine-specific policy overrides. Secrets stay in .env.",
  "warmup": {
    "mode": "force"
  },
  "promo": {
    "onExceed": "warn"
  },
  "postWatch": {
    "minAgeHours": 24,
    "maxAgeHours": 72
  },
  "cadence": {
    "maxHelpPerDay": 5,
    "maxPromoPerDay": 1,
    "scheduleCron": "0 9,13,18 * * *",
    "maxJobsPerRun": 2
  },
  "visibility": {
    "delayMs": 3000
  },
  "scout": {
    "maxSubs": 2
  }
}
