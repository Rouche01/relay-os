{
  "name": "@relay/apps-community-engager",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json -w",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/test/*.test.js",
    "clean": "rm -rf dist dist-test",
    "start": "node dist/run-dev.js",
    "e2e": "node dist/e2e-hitl.js",
    "smoke": "node dist/e2e-hitl.js",
    "verify:voltmem-events": "node dist/verify-voltmem-events.js",
    "login:reddit": "node dist/run-login.js",
    "admin:store": "node dist/admin.js",
    "actions": "node ../../packages/action-store/dist/cli.js"
  },
  "dependencies": {
    "@google/genai": "2.27.0",
    "@relay/action-store": "workspace:*",
    "@relay/admin-shell": "workspace:*",
    "@relay/adapters-telegram": "workspace:*",
    "@relay/context-engine": "workspace:*",
    "@relay/engines-browser": "workspace:*",
    "@relay/engines-decide": "workspace:*",
    "@relay/feedback-broker": "workspace:*",
    "@relay/protocol": "workspace:*",
    "@relay/runtime": "workspace:*",
    "dotenv": "^16.4.5",
    "playwright": "^1.43.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "6.0.3"
  }
}
