{
  "name": "@relay/apps-community-engager",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json -w",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/test/*.test.js",
    "clean": "rm -rf dist dist-test",
    "start": "node dist/host/run-dev.js",
    "watch:posts": "node dist/host/run-dev.js --entrypoint post_watch",
    "scheduler": "node dist/host/run-scheduler.js",
    "ops": "node dist/host/run-ops.js",
    "e2e": "node dist/host/e2e-hitl.js",
    "smoke": "node dist/host/e2e-hitl.js",
    "verify:voltmem-events": "node dist/host/verify-voltmem-events.js",
    "login:reddit": "node dist/host/run-login.js",
    "admin:store": "node dist/host/admin.js",
    "actions": "node ../../packages/action-store/dist/cli.js"
  },
  "dependencies": {
    "@google/genai": "2.27.0",
    "@relay/action-store": "workspace:*",
    "@relay/adapters-telegram": "workspace:*",
    "@relay/admin-shell": "workspace:*",
    "@relay/context-engine": "workspace:*",
    "@relay/engines-browser": "workspace:*",
    "@relay/engines-decide": "workspace:*",
    "@relay/feedback-broker": "workspace:*",
    "@relay/protocol": "workspace:*",
    "@relay/runtime": "workspace:*",
    "@relay/scheduler": "workspace:*",
    "dotenv": "^16.4.5",
    "playwright": "^1.64.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "6.0.3"
  }
}
