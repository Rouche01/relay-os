    "@relay/runtime": "workspace:*",
    "@relay/spec-evals": "workspace:*",
    "@relay/spec-host": "workspace:*",
    "@relay/spec-lower": "workspace:*",
    "@relay/spec-scaffold": "workspace:*",
    "@relay/spec-store": "workspace:*",
    "@relay/spec-validator": "workspace:*",
    "@relay/workflow-runtime": "workspace:*",
    "dotenv": "^16.4.5",
    "preact": "^10.26.4"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.1",
    "@types/node": "^22.0.0",
