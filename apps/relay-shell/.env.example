# Relay shell Spec API — copy to `.env` in this directory.
#   cp apps/relay-shell/.env.example apps/relay-shell/.env
# Loaded by `pnpm --filter @relay/apps-relay-shell api` (not by Desk / Tauri).

# Spec UI / API bind (defaults: 127.0.0.1:8790)
# SPEC_UI_HOST=127.0.0.1
# SPEC_UI_PORT=8790

# Spec store path (default: .data under cwd)
# RELAY_DATA_DIR=.data

# Live Spec v2 scaffold (Desk → POST /api/v2/scaffold)
# Unset key → offline stub Spec (goal rewritten from Intent).
# Force stub even when a key is set:
# RELAY_SPEC_SCAFFOLD_STUB=1
LLM_PROVIDER=gemini
# Free-tier Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=

# Legacy Spec compose (decide → pack / primitives)
# RELAY_SHELL_COMPOSE=primitives
# DECIDE_BACKEND=heuristic

# Serve Vite dist from the API process
# RELAY_SHELL_SERVE_UI=1
# RELAY_SHELL_DIST=
